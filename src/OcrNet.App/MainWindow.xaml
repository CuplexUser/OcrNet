<Window x:Class="OcrNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OcrNet.App.Views"
        Title="{Binding State.WindowTitle}"
        Icon="/Assets/OcrNet.ico"
        Width="1440" Height="920" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity, current model and file commands -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas Width="26" Height="26" Margin="0,0,10,0">
                        <Ellipse Canvas.Left="1" Canvas.Top="4" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                        <Ellipse Canvas.Left="1" Canvas.Top="16" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                        <Ellipse Canvas.Left="19" Canvas.Top="10" Width="6" Height="6" Fill="{StaticResource SignalBrush}" />
                        <Line X1="7" Y1="7" X2="19" Y2="13" Stroke="{StaticResource SignalBrush}" StrokeThickness="1.5" />
                        <Line X1="7" Y1="19" X2="19" Y2="13" Stroke="{StaticResource NegativeBrush}" StrokeThickness="1.5" />
                    </Canvas>
                    <TextBlock Text="OcrNet" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="16,0" />
                    <TextBlock Text="{Binding State.ModelSummary}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open…" Command="{Binding OpenCommand}" Margin="0,0,8,0" ToolTip="Open a .ocrnet model (Ctrl+O)" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" ToolTip="Save the model (Ctrl+S)" />
                    <Button Content="Save as…" Command="{Binding SaveAsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="12,8,12,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="1  Design">
                <views:DesignerView DataContext="{Binding Designer}" />
            </TabItem>
            <TabItem Header="2  Dataset">
                <views:DatasetView DataContext="{Binding Dataset}" />
            </TabItem>
            <TabItem Header="3  Training">
                <views:TrainingView DataContext="{Binding Training}" />
            </TabItem>
            <TabItem Header="4  Recognize">
                <views:RecognizeView x:Name="RecognizePage" DataContext="{Binding Recognize}" />
            </TabItem>
            <TabItem Header="5  Visualize">
                <views:VisualizeView DataContext="{Binding Visualize}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SignalBrush}" Text="● training"
                           Visibility="{Binding State.IsTraining, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding State.Status}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OcrNet.App</RootNamespace>
    <AssemblyTitle>OcrNet</AssemblyTitle>
    <ApplicationIcon>Assets\OcrNet.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The Fluent theme (Application.ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcrNet.Core\OcrNet.Core.csproj" />
    <ProjectReference Include="..\OcrNet.Data\OcrNet.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OcrNet.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>

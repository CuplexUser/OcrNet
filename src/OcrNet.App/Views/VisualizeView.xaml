<UserControl x:Class="OcrNet.App.Views.VisualizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OcrNet.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,12,4,8">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Neurons per layer" Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="4" Maximum="40" Value="{Binding MaxNodes}" Width="120" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MaxNodes}" Style="{StaticResource Mono}" Width="28" VerticalAlignment="Center" Margin="6,0,16,0" />
                                <TextBlock Text="Edges per neuron" Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="1" Maximum="24" Value="{Binding EdgesPerNode}" Width="120" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EdgesPerNode}" Style="{StaticResource Mono}" Width="28" VerticalAlignment="Center" Margin="6,0,16,0" />
                                <CheckBox Content="Most active neurons" IsChecked="{Binding ShowMostActive}" />
                            </StackPanel>
                            <TextBlock Text="Network" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="{Binding Architecture}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Teal = positive weight, coral = negative. With a drawing on the Recognize tab, nodes light up with their activation and edge opacity shows the signal |weight × activation| actually flowing. Small squares are first-layer receptive fields." />
                    </StackPanel>
                    <controls:NetworkGraphControl Height="560" Network="{Binding Network}" Input="{Binding Input}" LayerOutputs="{Binding LayerOutputs}"
                                                  MaxNodes="{Binding MaxNodes}" EdgesPerNode="{Binding EdgesPerNode}"
                                                  ShowMostActive="{Binding ShowMostActive}" WeightsVersion="{Binding WeightsVersion}" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="First-layer receptive fields (what each neuron looks for)" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ReceptiveFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,6">
                                        <Image Source="{Binding Image}" Width="56" Height="56" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Mono}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Weight distributions" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Histograms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:HistogramControl Title="{Binding Title}" Values="{Binding Values}" Height="110" Margin="0,0,0,12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="220">
                        <controls:LineChart Title="Training history · accuracy %" YFormat="0.#"
                                            Series="{Binding DataContext.Training.AccuracySeries, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

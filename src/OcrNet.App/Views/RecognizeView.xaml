<UserControl x:Class="OcrNet.App.Views.RecognizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,12,4,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One character: drawing on the left, results on the right. A line of text needs the wide
             canvas, so the drawing goes on top and the results below it, using the full width. -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LineMode}" Value="True">
                            <Setter Property="Grid.RowSpan" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Content="One character" IsChecked="{Binding IsSingleMode, Mode=OneWay}" Checked="OnSingleMode" Margin="0,0,8,0" MinWidth="0" />
                        <RadioButton Content="A line of text" IsChecked="{Binding LineMode}" MinWidth="0" />
                    </StackPanel>
                    <TextBlock Text="Draw here" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="#0A0D11" ClipToBounds="True">
                    <InkCanvas x:Name="Canvas" Background="Transparent" Cursor="Pen">
                        <InkCanvas.Style>
                            <Style TargetType="InkCanvas">
                                <Setter Property="Width" Value="380" />
                                <Setter Property="Height" Value="380" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineMode}" Value="True">
                                        <Setter Property="Width" Value="780" />
                                        <Setter Property="Height" Value="240" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </InkCanvas.Style>
                    </InkCanvas>
                </Border>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Clear  (Esc)" Click="OnClear" />
                    <TextBlock Text="Pen" Style="{StaticResource FieldLabel}" />
                    <Slider Minimum="6" Maximum="40" Value="{Binding PenWidth}" Width="140" VerticalAlignment="Center" ValueChanged="OnPenWidthChanged" />
                    <TextBlock Text="Right-drag erases" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0" />
                </DockPanel>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="0,10,0,0" MaxWidth="{Binding ActualWidth, ElementName=Canvas}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Grid.Column" Value="2" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LineMode}" Value="True">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.RowSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recognized" Style="{StaticResource SectionTitle}" />
                        <!-- Single character: normalized input, big answer and top-5 probabilities -->
                        <Grid Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="112" Height="112">
                                    <Image Source="{Binding NormalizedImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="network input 28×28" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Recognized}" FontSize="84" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource HighlightBrush}" MinWidth="120" VerticalAlignment="Center" Margin="0,-10,24,0" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding TopPredictions}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Mono}" FontSize="16" />
                                            <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Probability, Mode=OneWay}" Height="8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Probability, StringFormat={}{0:P1}}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <!-- Line mode: the segmented characters -->
                        <StackPanel Visibility="{Binding LineMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Recognized}" FontSize="48" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource HighlightBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,10">
                                            <Image Source="{Binding Image}" Width="56" Height="56" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Mono}">
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                <Run Text="{Binding Confidence, Mode=OneWay, StringFormat={}{0:P0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Text="Characters are separated where there is a vertical gap in the ink, so leave a little space between them." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                    <Setter Property="Text" Value="Teach – wrong answer? Save the drawing with the correct label" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LineMode}" Value="True">
                                            <Setter Property="Text" Value="Teach – wrong answer? Type the whole line correctly, one character per box above" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding TeachLabel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="16">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Width" Value="60" />
                                        <Setter Property="MaxLength" Value="1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LineMode}" Value="True">
                                                <Setter Property="Width" Value="260" />
                                                <Setter Property="MaxLength" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding TeachCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Save as training sample" Command="{Binding TeachCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TeachStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Test with an installed font" Style="{StaticResource SectionTitle}" />
                        <!-- Wraps instead of clipping when the window is narrow. -->
                        <WrapPanel Margin="0,0,0,-8">
                            <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" Width="220" Margin="0,0,8,8" />
                            <TextBox Text="{Binding FontTestText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding TestFontCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Classify" Command="{Binding TestFontCommand}" Margin="0,0,16,8" />
                            <CheckBox Content="Only mistakes" IsChecked="{Binding ShowOnlyMistakes}" Margin="0,0,0,8" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FontTestSummary}" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Left" Content="Add mistakes to training data" Command="{Binding AddMistakesToTrainingCommand}" VerticalAlignment="Top"
                                    ToolTip="Saves each misclassified glyph as a training sample; they are mixed into training the next time you train" />
                            <TextBlock Text="{Binding FontTrainStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding FontTestResults}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Mistakes stand out: coral frame and tint, predicted character in coral. -->
                                    <Border x:Name="Tile" Margin="0,0,8,8" Width="72" Padding="4,6" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="#332EC4B6" Background="Transparent" ToolTip="{Binding Details}">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Margin="0,4,0,0">
                                                <Run Text="{Binding Expected, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                <Run Text="→" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                <Run x:Name="PredictedRun" Text="{Binding Predicted, Mode=OneWay}" Foreground="{StaticResource SignalBrush}" />
                                            </TextBlock>
                                            <TextBlock x:Name="Note" Text="{Binding Confidence, StringFormat={}{0:P0}}" HorizontalAlignment="Center"
                                                       Style="{StaticResource Caption}" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Outcome}" Value="Wrong">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource NegativeBrush}" />
                                            <Setter TargetName="Tile" Property="Background" Value="#33FF6B57" />
                                            <Setter TargetName="PredictedRun" Property="Foreground" Value="{StaticResource NegativeBrush}" />
                                            <Setter TargetName="PredictedRun" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Outcome}" Value="NotAClass">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter TargetName="Tile" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="PredictedRun" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter TargetName="Note" Property="Text" Value="not a class" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
